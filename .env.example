# --- Engine ---------------------------------------------------------------
# "mock" (default) returns a deterministic demo verdict with no dependencies.
# "cli" spawns the real extracted cortex-x engine (set CODECEIPT_ENGINE_BIN).
CODECEIPT_ENGINE_MODE=mock
# CODECEIPT_ENGINE_BIN=/absolute/path/to/codeceipt-engine

# --- GitHub ---------------------------------------------------------------
# Needed to fetch diffs from private repos + raise the rate limit.
# GITHUB_TOKEN=ghp_xxx

# --- Storage (Vercel KV) --------------------------------------------------
# Without these, receipts are stored in-memory (ephemeral) — fine for local dev.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
