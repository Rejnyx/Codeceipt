# --- Engine ---------------------------------------------------------------
# "static" (default) runs real diff-based verification via @codeceipt/engine.
# "mock" returns a deterministic offline verdict for a no-network demo.
CODECEIPT_ENGINE_MODE=static

# --- GitHub ---------------------------------------------------------------
# Needed to fetch diffs from private repos + raise the rate limit.
# GITHUB_TOKEN=ghp_xxx

# --- Storage (Vercel KV) --------------------------------------------------
# Without these, receipts are stored in-memory (ephemeral) — fine for local dev.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
