# Codeceipt — environment (all optional; the app runs with zero config)
#
# Engine mode: "static" (real diff verification, default) | "mock" (offline demo)
CODECEIPT_ENGINE_MODE=static
#
# GitHub token — only needed to scan PRs in PRIVATE repos (and for higher rate
# limits). Public PRs work without it.
GITHUB_TOKEN=
#
# Receipt storage (production). Provision a Redis/KV integration from the Vercel
# Marketplace (Upstash); it injects these automatically. Without them, receipts
# are in-memory and disappear across serverless instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# Publishing receipts from the GitHub Action (POST /api/ingest):
#   - CODECEIPT_INGEST_TOKEN: a shared secret. REQUIRED in production — without it
#     the ingest endpoint fails closed (anyone could otherwise forge a VERIFIED
#     receipt). The Action passes the same value as a Bearer token.
#   - CODECEIPT_PUBLIC_URL: the public origin, used to build the returned /r/<id>
#     link (e.g. https://codeceipt.dev).
CODECEIPT_INGEST_TOKEN=
CODECEIPT_PUBLIC_URL=
#
# Optional llm_judge intent check (deterministic-first; skipped if unset).
OPENAI_API_KEY=
CODECEIPT_JUDGE_MODEL=
#
# CLI engine mode knobs (only if CODECEIPT_ENGINE_MODE points at an external bin)
CODECEIPT_ENGINE_BIN=
