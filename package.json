{
  "name": "codeceipt",
  "version": "0.1.0",
  "private": true,
  "description": "Public, independently-verifiable proof that an AI-authored PR did what it claimed.",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && pnpm --filter @codeceipt/engine typecheck",
    "engine": "pnpm --filter @codeceipt/engine cli",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codeceipt/engine": "workspace:*",
    "@vercel/kv": "^3.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tar-stream": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/tar-stream": "^3.1.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
